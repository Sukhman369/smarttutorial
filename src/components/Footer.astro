---
// Footer.astro
---

<footer class="bg-slate-950 text-slate-400 text-sm border-t border-slate-900 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-900">
      
      <!-- Brand & About (Span 2) -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-sm">
            ST
          </div>
          <div>
            <span class="text-lg font-black text-white tracking-tight">SMART TUTORIALS</span>
            <div class="text-[10px] text-blue-400 font-bold uppercase tracking-wider">Samana, Distt. Patiala, Punjab</div>
          </div>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          A dedicated training institute and study visa consultancy in Samana offering certified preparation for IELTS, PTE, Air Hostess & Aviation careers, and modern computer & AI certifications.
        </p>

        <div class="text-xs text-slate-300 space-y-1">
          <div><strong>Address:</strong> Near Main Bus Stand / Main Market, Samana, Punjab 147101</div>
          <div><strong>Phone:</strong> +91-98765-43210</div>
          <div><strong>Email:</strong> info@smarttutorials-samana.com</div>
        </div>
      </div>

      <!-- Quick Links 1: Test Prep & Visas -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">Test Prep & Visas</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#ielts" class="hover:text-blue-400 transition">IELTS Academic & General</a></li>
          <li><a href="#ielts" class="hover:text-blue-400 transition">PTE Computerized Lab</a></li>
          <li><a href="#ielts" class="hover:text-blue-400 transition">Spoken English & Grammar</a></li>
          <li><a href="#visa" class="hover:text-blue-400 transition">Canada Student Visa (SDS)</a></li>
          <li><a href="#visa" class="hover:text-blue-400 transition">Australia & UK Study Visas</a></li>
          <li><a href="#visa" class="hover:text-blue-400 transition">Tourist & Visitor Visas</a></li>
        </ul>
      </div>

      <!-- Quick Links 2: Aviation & Computer Courses -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">Aviation & Skills</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#aviation" class="hover:text-amber-400 transition">Air Hostess & Cabin Crew</a></li>
          <li><a href="#aviation" class="hover:text-amber-400 transition">Airport Ground Operations</a></li>
          <li><a href="#aviation" class="hover:text-amber-400 transition">Grooming & Personality Dev</a></li>
          <li><a href="#computer" class="hover:text-indigo-400 transition">MS Office & Basic Computing</a></li>
          <li><a href="#computer" class="hover:text-indigo-400 transition">Tally Prime & GST Accounting</a></li>
          <li><a href="#computer" class="hover:text-indigo-400 transition">Modern AI Tools & Workflows</a></li>
        </ul>
      </div>

      <!-- Quick Links 3: Student Portal & Hours -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">Campus Hours</h4>
        <div class="text-xs space-y-2">
          <p><strong class="text-white">Monday - Saturday:</strong><br />8:00 AM - 6:30 PM</p>
          <p><strong class="text-white">Sunday:</strong><br />Closed for in-person classes (Online support active)</p>
          <div class="pt-2">
            <a 
              href="#contact" 
              class="inline-block py-2 px-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs transition"
            >
              Book Free Trial Class
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-300">
      <p>© {new Date().getFullYear()} Smart Tutorials, Samana. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#services" class="hover:text-slate-300 transition">Courses</a>
        <a href="#visa" class="hover:text-slate-300 transition">Visa Filing</a>
        <a href="#contact" class="hover:text-slate-300 transition">Samana Campus</a>
      </div>
    </div>

  </div>
</footer>
