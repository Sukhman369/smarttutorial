---
// Hero.astro
---

<section class="relative overflow-hidden bg-gradient-to-b from-blue-50/70 via-white to-slate-50 pt-12 pb-20 lg:pt-20 lg:pb-28">
  <!-- Subtle decorative background grid pattern -->
  <div class="absolute inset-0 bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:20px_20px] opacity-10 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Content & Pitch -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Local Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-semibold tracking-wide border border-blue-200">
          <span class="flex h-2 w-2 rounded-full bg-blue-600"></span>
          <span>Samana's Trusted Career & Study Abroad Hub</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.12]">
          Build Your Global Career Right Here From <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-indigo-600 to-sky-600">Samana</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          From achieving your target <strong>IELTS/PTE bands</strong> and transparent <strong>Study Visa Filing</strong>, to professional <strong>Air Hostess Training</strong> and career-ready <strong>Computer & AI Skills</strong>. Everything you need under one roof.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a 
            href="#contact" 
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl bg-blue-700 hover:bg-blue-800 text-white font-bold text-base shadow-lg shadow-blue-700/25 transition active:scale-95"
          >
            <span>Book Free Demo Class</span>
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a 
            href="https://wa.me/919876543210?text=Hello%20Smart%20Tutorials,%20I%20want%20to%20know%20more%20about%20admissions." 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-base shadow-md shadow-emerald-600/20 transition active:scale-95 gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Chat on WhatsApp</span>
          </a>
        </div>

        <!-- Trust Points Strip -->
        <div class="pt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-slate-200">
          <div>
            <div class="text-2xl font-black text-slate-900">7.5+</div>
            <div class="text-xs text-slate-600 font-medium">Top IELTS Bands</div>
          </div>
          <div>
            <div class="text-2xl font-black text-slate-900">100%</div>
            <div class="text-xs text-slate-600 font-medium">Transparent Filing</div>
          </div>
          <div>
            <div class="text-2xl font-black text-slate-900">Aviation</div>
            <div class="text-xs text-slate-600 font-medium">Cabin Crew Training</div>
          </div>
          <div>
            <div class="text-2xl font-black text-slate-900">Modern</div>
            <div class="text-xs text-slate-600 font-medium">Computer & AI Lab</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Feature Card Stack -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md">
          
          <!-- Decorative Glow -->
          <div class="absolute -top-4 -left-4 w-72 h-72 bg-blue-300 rounded-full filter blur-3xl opacity-30 animate-pulse"></div>
          <div class="absolute -bottom-4 -right-4 w-72 h-72 bg-amber-300 rounded-full filter blur-3xl opacity-30"></div>

          <!-- Feature Card Container -->
          <div class="relative bg-white rounded-2xl shadow-xl border border-slate-100 p-6 sm:p-8 space-y-5">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-3 py-1 rounded-md">
                Why Students in Samana Choose Us
              </span>
              <span class="text-xs text-emerald-600 font-bold flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> New Batches Open
              </span>
            </div>

            <!-- Program Highlight 1: IELTS & PTE -->
            <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-slate-50 transition">
              <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 font-bold">
                🎯
              </div>
              <div>
                <h2 class="text-sm font-bold text-slate-900">IELTS & PTE Academic Coaching</h2>
                <p class="text-xs text-slate-500 mt-0.5">Special 1-on-1 speaking cabins & PTE computerized software lab practice.</p>
              </div>
            </div>

            <!-- Program Highlight 2: Visa Services -->
            <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-slate-50 transition">
              <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 font-bold">
                ✈️
              </div>
              <div>
                <h2 class="text-sm font-bold text-slate-900">Study & Visitor Visa Filing</h2>
                <p class="text-xs text-slate-500 mt-0.5">Specializing in Canada, UK, Australia & Europe with complete SOP guidance.</p>
              </div>
            </div>

            <!-- Program Highlight 3: Aviation -->
            <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-slate-50 transition">
              <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 font-bold">
                👩‍✈️
              </div>
              <div>
                <h2 class="text-sm font-bold text-slate-900">Air Hostess & Aviation Grooming</h2>
                <p class="text-xs text-slate-500 mt-0.5">Cabin crew grooming, personality building & airline interview mastery.</p>
              </div>
            </div>

            <!-- Program Highlight 4: AI & Computer -->
            <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-slate-50 transition">
              <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center shrink-0 font-bold">
                💻
              </div>
              <div>
                <h2 class="text-sm font-bold text-slate-900">Computer Skills & Modern AI Tools</h2>
                <p class="text-xs text-slate-500 mt-0.5">Hands-on office tools, accounting, typing, and practical modern AI workflows.</p>
              </div>
            </div>

            <!-- Bottom Quick Action -->
            <div class="pt-2">
              <a 
                href="#contact" 
                class="block w-full py-2.5 px-4 text-center rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold tracking-wide transition"
              >
                Inquire For Next Batch Timing →
              </a>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
