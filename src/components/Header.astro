---
// Header.astro
---

<!-- Top Announcement & Contact Bar -->
<div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
    <div class="flex items-center gap-4 flex-wrap justify-center sm:justify-start">
      <span class="inline-flex items-center gap-1.5 text-slate-200">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span>Near Bus Stand / Main Market, <strong>Samana (Distt. Patiala)</strong></span>
      </span>
      <span class="hidden md:inline-block text-slate-600">|</span>
      <span class="inline-flex items-center gap-1.5 text-slate-300">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Mon - Sat: 8:00 AM - 6:30 PM</span>
      </span>
    </div>

    <div class="flex items-center gap-4 text-xs font-medium">
      <a href="tel:+919876543210" class="hover:text-amber-400 transition flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>+91-98765-43210</span>
      </a>
      <span class="text-slate-600">|</span>
      <a 
        href="https://wa.me/919876543210?text=Hello%20Smart%20Tutorials,%20I%20am%20interested%20in%20courses%20or%20visa%20guidance." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-emerald-400 hover:text-emerald-300 transition flex items-center gap-1 font-semibold"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        WhatsApp Inquiries
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-blue-700 to-indigo-600 flex items-center justify-center text-white font-bold text-xl shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
          ST
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-tight text-slate-900 group-hover:text-blue-700 transition">
            SMART TUTORIALS
          </span>
          <span class="text-[10px] font-semibold tracking-wider uppercase text-blue-700">
            IELTS • Visa • Aviation • AI Tech
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-7 text-sm font-semibold text-slate-700">
        <a href="#services" class="hover:text-blue-600 transition">All Programs</a>
        <a href="#ielts" class="hover:text-blue-600 transition">IELTS & PTE</a>
        <a href="#visa" class="hover:text-blue-600 transition">Visa Filing</a>
        <a href="#aviation" class="hover:text-blue-600 transition">Air Hostess</a>
        <a href="#computer" class="hover:text-blue-600 transition">Computer & AI</a>
        <a href="#why-us" class="hover:text-blue-600 transition">Why Us</a>
        <a href="#contact" class="hover:text-blue-600 transition">Location</a>
      </nav>

      <!-- Right Action CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="#contact" 
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shadow-md shadow-blue-600/25 transition active:scale-95"
        >
          Book Free Demo Class
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden flex items-center">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          aria-label="Toggle navigation menu"
          class="p-2 rounded-lg text-slate-700 hover:bg-slate-100 transition"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white px-4 py-4 space-y-3">
    <a href="#services" class="block px-3 py-2 rounded-md text-base font-semibold text-slate-800 hover:bg-blue-50 hover:text-blue-700">All Programs</a>
    <a href="#ielts" class="block px-3 py-2 rounded-md text-base font-semibold text-slate-800 hover:bg-blue-50 hover:text-blue-700">IELTS & PTE Coaching</a>
    <a href="#visa" class="block px-3 py-2 rounded-md text-base font-semibold text-slate-800 hover:bg-blue-50 hover:text-blue-700">Visa Filing & Consultation</a>
    <a href="#aviation" class="block px-3 py-2 rounded-md text-base font-semibold text-slate-800 hover:bg-blue-50 hover:text-blue-700">Air Hostess & Aviation</a>
    <a href="#computer" class="block px-3 py-2 rounded-md text-base font-semibold text-slate-800 hover:bg-blue-50 hover:text-blue-700">Computer & AI Courses</a>
    <a href="#why-us" class="block px-3 py-2 rounded-md text-base font-semibold text-slate-800 hover:bg-blue-50 hover:text-blue-700">Why Smart Tutorials</a>
    <a href="#contact" class="block px-3 py-2 rounded-md text-base font-semibold text-slate-800 hover:bg-blue-50 hover:text-blue-700">Samana Campus & Contact</a>
    <div class="pt-2">
      <a href="#contact" class="block text-center w-full py-3 rounded-lg bg-blue-600 text-white font-bold text-sm shadow">
        Book Free Consultation / Demo
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    // Close menu when clicking an anchor link
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }
</script>
