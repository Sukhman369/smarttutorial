---
// WhyUs.astro
---

<section id="why-us" class="py-20 bg-slate-900 text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-900/60 text-blue-300 text-xs font-bold uppercase tracking-wider border border-blue-800">
        The Smart Tutorials Edge
      </div>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight">
        Why Students In & Around Samana Choose Us
      </h2>
      <p class="text-slate-400 text-base leading-relaxed">
        We don't sell false dreams. We focus on discipline, practical labs, certified faculty, and direct mentorship that delivers tangible results.
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Card 1 -->
      <div class="bg-slate-800/80 rounded-2xl p-7 border border-slate-700/80 hover:border-blue-500/50 transition">
        <div class="w-12 h-12 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center font-bold text-xl mb-5">
          🎯
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Small Batches & Individual Care</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          No overcrowded 40-student rooms. We keep batch sizes tight so every learner receives personal attention and spoken feedback.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-slate-800/80 rounded-2xl p-7 border border-slate-700/80 hover:border-emerald-500/50 transition">
        <div class="w-12 h-12 rounded-xl bg-emerald-600/20 text-emerald-400 flex items-center justify-center font-bold text-xl mb-5">
          📜
        </div>
        <h3 class="text-lg font-bold text-white mb-2">100% Transparent Visa Consultation</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Direct eligibility checks without deceptive promises. Complete visibility into your offer letter, GIC, tuition fee, and embassy submission.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="bg-slate-800/80 rounded-2xl p-7 border border-slate-700/80 hover:border-amber-500/50 transition">
        <div class="w-12 h-12 rounded-xl bg-amber-600/20 text-amber-400 flex items-center justify-center font-bold text-xl mb-5">
          ✈️
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Real Airline Mock Drill Sessions</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Dedicated grooming and personality sessions modeled directly on domestic (IndiGo, Air India) and international airline assessment days.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="bg-slate-800/80 rounded-2xl p-7 border border-slate-700/80 hover:border-indigo-500/50 transition">
        <div class="w-12 h-12 rounded-xl bg-indigo-600/20 text-indigo-400 flex items-center justify-center font-bold text-xl mb-5">
          💻
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Modern Air-Conditioned Lab</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Equipped with dedicated workstations for PTE software mock exams, typing exams, and practical computer programming / AI practice.
        </p>
      </div>

      <!-- Card 5 -->
      <div class="bg-slate-800/80 rounded-2xl p-7 border border-slate-700/80 hover:border-sky-500/50 transition">
        <div class="w-12 h-12 rounded-xl bg-sky-600/20 text-sky-400 flex items-center justify-center font-bold text-xl mb-5">
          📍
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Prime Accessible Samana Location</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Conveniently located near the main bus terminal and market, making it easy and safe for students traveling from nearby villages and Patiala.
        </p>
      </div>

      <!-- Card 6 -->
      <div class="bg-slate-800/80 rounded-2xl p-7 border border-slate-700/80 hover:border-rose-500/50 transition">
        <div class="w-12 h-12 rounded-xl bg-rose-600/20 text-rose-400 flex items-center justify-center font-bold text-xl mb-5">
          🤝
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Free Trial / Diagnostic Demo</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Attend 2 demo classes before you pay any course fee. Test our teaching quality, faculty guidance, and lab environment risk-free.
        </p>
      </div>

    </div>

    <!-- Quick Callout Banner -->
    <div class="mt-16 bg-gradient-to-r from-blue-900 to-indigo-900 rounded-2xl p-8 border border-blue-700/50 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-xl font-bold text-white">Ready to begin your journey?</h3>
        <p class="text-blue-200 text-sm mt-1">Walk in for a free diagnostic test or profile consultation today.</p>
      </div>
      <a 
        href="#contact" 
        class="shrink-0 px-6 py-3 rounded-xl bg-white text-blue-900 hover:bg-blue-50 font-bold text-sm shadow transition"
      >
        Book Free Diagnostic Test
      </a>
    </div>

  </div>
</section>
