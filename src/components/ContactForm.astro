---
// ContactForm.astro
---

<section id="contact" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Column: Campus Info & Contact Details -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-3 py-1 rounded-md">
            Visit Our Samana Center
          </span>
          <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-3">
            Get In Touch or Walk In For a Free Consultation
          </h2>
          <p class="text-slate-600 text-sm mt-2 leading-relaxed">
            Our counselors and faculty are ready to assist you. Have your questions answered on batch timings, course fees, or visa profile assessment.
          </p>
        </div>

        <!-- Campus Details Cards -->
        <div class="space-y-4 pt-2">
          
          <div class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
              📍
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Campus Address</h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Smart Tutorials, Near Bus Stand / Main Market,<br />
                Samana, District Patiala, Punjab - 147101
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
              📞
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Direct Contact Numbers</h3>
              <p class="text-xs text-slate-600 mt-1">
                Call: <a href="tel:+919876543210" class="text-blue-600 font-semibold hover:underline">+91-98765-43210</a><br />
                WhatsApp: <a href="https://wa.me/919876543210" target="_blank" rel="noopener noreferrer" class="text-emerald-600 font-semibold hover:underline">+91-98765-43210</a>
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
              ⏰
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Institute Timings</h3>
              <p class="text-xs text-slate-600 mt-1">
                Monday to Saturday: 8:00 AM - 6:30 PM<br />
                Sunday: Closed (Available for online WhatsApp queries)
              </p>
            </div>
          </div>

        </div>

        <!-- Quick Map Pin Callout -->
        <div class="p-4 bg-blue-50 border border-blue-200 rounded-xl text-xs text-blue-900 font-medium">
          💡 <strong>Tip for visitors:</strong> If you are coming from Patiala or Patran by bus, our center is within 3 minutes walking distance from the Samana main bus terminal.
        </div>
      </div>

      <!-- Right Column: Quick Lead Assessment Form -->
      <div class="lg:col-span-7">
        <div class="bg-slate-50 rounded-3xl p-8 border border-slate-200/90 shadow-sm">
          <div class="mb-6">
            <h3 class="text-xl font-bold text-slate-900">Book Free Demo / Profile Evaluation</h3>
            <p class="text-xs text-slate-500 mt-1">Fill out the quick form below. You can submit directly via WhatsApp for instant reply!</p>
          </div>

          <form id="lead-form" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Your Full Name *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="e.g. Harpreet Singh" 
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 bg-white text-sm"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Mobile / WhatsApp Number *</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  required 
                  placeholder="e.g. 9876543210" 
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 bg-white text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="program" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Interested Program *</label>
                <select 
                  id="program" 
                  name="program" 
                  required 
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 bg-white text-sm text-slate-800"
                >
                  <option value="IELTS / PTE Coaching">IELTS / PTE Coaching</option>
                  <option value="Study Visa Filing (Canada/UK/Aus)">Study Visa Filing (Canada/UK/Aus)</option>
                  <option value="Air Hostess / Cabin Crew Training">Air Hostess / Cabin Crew Training</option>
                  <option value="Computer & AI Courses">Computer & AI Courses</option>
                  <option value="Other / General Inquiry">Other / General Inquiry</option>
                </select>
              </div>

              <div>
                <label for="batch" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Preferred Time / Intake</label>
                <select 
                  id="batch" 
                  name="batch" 
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 bg-white text-sm text-slate-800"
                >
                  <option value="Morning Batch (9:00 AM)">Morning Batch (9:00 AM)</option>
                  <option value="Afternoon Batch (1:00 PM)">Afternoon Batch (1:00 PM)</option>
                  <option value="Evening Batch (4:30 PM)">Evening Batch (4:30 PM)</option>
                  <option value="Immediate Visa Consultation">Immediate Visa Consultation</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Additional Note (Optional)</label>
              <textarea 
                id="message" 
                name="message" 
                rows="3" 
                placeholder="Tell us about your qualification or target country (e.g. 12th passed in 2024, want to go to Canada)..." 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 bg-white text-sm"
              ></textarea>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row gap-3">
              <button 
                type="submit" 
                class="flex-1 py-3 px-6 rounded-xl bg-blue-700 hover:bg-blue-800 text-white font-bold text-sm shadow-md shadow-blue-700/20 transition active:scale-95"
              >
                Send Inquiry Now
              </button>

              <button 
                type="button" 
                id="whatsapp-submit-btn" 
                class="py-3 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-600/20 transition active:scale-95 flex items-center justify-center gap-2"
              >
                <span>Send via WhatsApp</span>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                </svg>
              </button>
            </div>

            <div id="form-feedback" class="hidden p-3 rounded-lg text-xs font-semibold"></div>

          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const whatsappBtn = document.getElementById('whatsapp-submit-btn');
  const feedback = document.getElementById('form-feedback');

  function getFormData() {
    const name = (document.getElementById('name') as HTMLInputElement)?.value || '';
    const phone = (document.getElementById('phone') as HTMLInputElement)?.value || '';
    const program = (document.getElementById('program') as HTMLSelectElement)?.value || '';
    const batch = (document.getElementById('batch') as HTMLSelectElement)?.value || '';
    const message = (document.getElementById('message') as HTMLTextAreaElement)?.value || '';
    return { name, phone, program, batch, message };
  }

  if (whatsappBtn) {
    whatsappBtn.addEventListener('click', () => {
      const { name, phone, program, batch, message } = getFormData();
      if (!name || !phone) {
        alert('Please enter your name and phone number first.');
        return;
      }
      const text = `*New Inquiry for Smart Tutorials (Samana)*%0A%0A*Name:* ${encodeURIComponent(name)}%0A*Phone:* ${encodeURIComponent(phone)}%0A*Program:* ${encodeURIComponent(program)}%0A*Timing/Preference:* ${encodeURIComponent(batch)}%0A*Note:* ${encodeURIComponent(message || 'None')}`;
      window.open(`https://wa.me/919876543210?text=${text}`, '_blank');
    });
  }

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const { name, phone, program, batch, message } = getFormData();
      if (feedback) {
        feedback.className = "p-3 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 block";
        feedback.innerHTML = `Thank you, <strong>${name}</strong>! Your inquiry for <strong>${program}</strong> has been registered. Our counselor will call you at <strong>${phone}</strong> shortly.`;
      }
      form.reset();
    });
  }
</script>
