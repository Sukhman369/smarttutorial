            <div class="space-y-3">
              <div class="p-3 bg-slate-50 rounded-xl">
                <div class="text-xs font-bold text-indigo-600">3 & 6 Months Diploma</div>
                <div class="text-sm font-semibold text-slate-800">DCA / PGDCA / Basic Office Computing Certification</div>
              </div>
              <div class="p-3 bg-slate-50 rounded-xl">
