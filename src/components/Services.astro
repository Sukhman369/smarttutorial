            <div class="pt-4 flex flex-wrap gap-3">
              <a href="#contact" class="px-5 py-2.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-semibold text-sm transition">
                Inquire For Aviation Course
              </a>
              <a href="https://wa.me/919876543210?text=I%20want%20to%20know%20eligibility%20and%20fees%20for%20Air%20Hostess%20training" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition">
                Check Eligibility on WhatsApp
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Target Career Roles</h4>
            <div class="space-y-3">
              <div class="border-l-2 border-amber-500 pl-3">
                <div class="text-sm font-bold text-slate-900">Cabin Crew / In-flight Attendant</div>
                <div class="text-xs text-slate-500">Commercial passenger airlines (Domestic & International)</div>
              </div>
              <div class="border-l-2 border-amber-500 pl-3">
                <div class="text-sm font-bold text-slate-900">Airport Ground Staff & Security</div>
                <div class="text-xs text-slate-500">Check-in counters, passenger handling, VIP lounge hospitality</div>
              </div>
              <div class="border-l-2 border-amber-500 pl-3">
                <div class="text-sm font-bold text-slate-900">Luxury Hospitality & Travel Consultant</div>
                <div class="text-xs text-slate-500">Five-star hotels, luxury cruise liners, international ticketing</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Computer & AI Courses -->
      <div id="computer" class="scroll-mt-24 rounded-3xl bg-gradient-to-br from-indigo-50/80 via-white to-slate-50 border border-indigo-100 p-8 sm:p-10 shadow-sm hover:shadow-md transition">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
