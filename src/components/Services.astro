---
// Services.astro
---

<section id="services" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wider">
        Comprehensive Education & Career Programs
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Four Specialized Wings. One Goal: Your Success.
      </h2>
      <p class="text-base text-slate-600 leading-relaxed">
        Whether you want to score top bands for studying abroad, fly across international skies, or master computer & AI technologies, Smart Tutorials provides dedicated faculty and practical training.
      </p>
    </div>

    <!-- The 4 Verticals Grid -->
    <div class="space-y-16">
      
      <!-- 1. IELTS & PTE Coaching -->
      <div id="ielts" class="scroll-mt-24 rounded-3xl bg-gradient-to-br from-blue-50/80 via-white to-slate-50 border border-blue-100 p-8 sm:p-10 shadow-sm hover:shadow-md transition">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-blue-600 text-white text-xs font-bold uppercase tracking-wider">
              Vertical 01 • Test Preparation
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
              IELTS & PTE Academic Coaching
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
              Achieve 7.0+ bands in IELTS and 65+ scores in PTE with our systematic, small-batch training. We emphasize conceptual grammar, active listening drills, structured essay templates, and daily one-on-one speaking assessments.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <div class="flex items-center gap-2 text-sm text-slate-700">
                <svg class="w-4 h-4 text-blue-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>Daily 1-on-1 Speaking Cabins</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-slate-700">
                <svg class="w-4 h-4 text-blue-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>Dedicated PTE Computer Software Lab</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-slate-700">
                <svg class="w-4 h-4 text-blue-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>Weekly Full Mock Tests & Band Analysis</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-slate-700">
                <svg class="w-4 h-4 text-blue-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>Special Grammar & Vocabulary Booster</span>
              </div>
            </div>

            <div class="pt-4 flex flex-wrap gap-3">
              <a href="#contact" class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition">
                Inquire for IELTS/PTE Batches
              </a>
              <a href="https://wa.me/919876543210?text=I%20want%20to%20know%20about%20IELTS%20and%20PTE%20coaching" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition">
                Get Syllabus via WhatsApp
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Course Highlights</h4>
            <div class="space-y-4">
              <div class="p-3 bg-slate-50 rounded-xl">
                <div class="text-xs font-bold text-blue-600">Batch Timings</div>
                <div class="text-sm font-semibold text-slate-800">Morning (9:00 AM) • Afternoon (1:00 PM) • Evening (4:30 PM)</div>
              </div>
              <div class="p-3 bg-slate-50 rounded-xl">
                <div class="text-xs font-bold text-blue-600">Target Band</div>
                <div class="text-sm font-semibold text-slate-800">Customized roadmap for 6.5, 7.0 & 8.0 Bands</div>
              </div>
              <div class="p-3 bg-slate-50 rounded-xl">
                <div class="text-xs font-bold text-blue-600">Free Assessment</div>
                <div class="text-sm font-semibold text-slate-800">Take a diagnostic test on Day 1 to map your weak areas</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Visa Filing & Immigration Services -->
      <div id="visa" class="scroll-mt-24 rounded-3xl bg-gradient-to-br from-emerald-50/80 via-white to-slate-50 border border-emerald-100 p-8 sm:p-10 shadow-sm hover:shadow-md transition">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-600 text-white text-xs font-bold uppercase tracking-wider">
              Vertical 02 • Global Mobility
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
              Study & Tourist Visa Filing
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
              Say goodbye to agent confusion and hidden conditions. We provide crystal-clear document assessment, college/university selection matching your profile, SOP drafting, and transparent visa file lodging.
            </p>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
              <div class="p-3 bg-white rounded-xl border border-slate-200 text-center">
                <div class="text-xl">🇨🇦</div>
                <div class="text-xs font-bold text-slate-800 mt-1">Canada</div>
                <div class="text-[11px] text-slate-500">SDS & Non-SDS</div>
              </div>
              <div class="p-3 bg-white rounded-xl border border-slate-200 text-center">
                <div class="text-xl">🇦🇺</div>
                <div class="text-xs font-bold text-slate-800 mt-1">Australia</div>
                <div class="text-[11px] text-slate-500">Higher Ed & VET</div>
              </div>
              <div class="p-3 bg-white rounded-xl border border-slate-200 text-center">
                <div class="text-xl">🇬🇧</div>
                <div class="text-xs font-bold text-slate-800 mt-1">United Kingdom</div>
                <div class="text-[11px] text-slate-500">Top Universities</div>
              </div>
              <div class="p-3 bg-white rounded-xl border border-slate-200 text-center">
                <div class="text-xl">🇪🇺</div>
                <div class="text-xs font-bold text-slate-800 mt-1">Europe & USA</div>
                <div class="text-[11px] text-slate-500">Schengen & Study</div>
              </div>
            </div>

            <div class="pt-4 flex flex-wrap gap-3">
              <a href="#contact" class="px-5 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition">
                Book Free Profile Assessment
              </a>
              <a href="https://wa.me/919876543210?text=I%20want%20to%20consult%20about%20Study%20Visa%20filing" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-white border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition">
                Send Resume / Documents on WhatsApp
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Visa Services Covered</h4>
            <ul class="space-y-3 text-sm text-slate-700 font-medium">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Complete Student Visa File Submission</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Visitor & Tourist Visa for Parents & Families</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Spouse Open Work Permit (SOWP) Guidance</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Professional Statement of Purpose (SOP) Drafting</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Refusal Case Re-assessment & Justification</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 3. Aviation & Air Hostess Academy -->
      <div id="aviation" class="scroll-mt-24 rounded-3xl bg-gradient-to-br from-amber-50/80 via-white to-slate-50 border border-amber-100 p-8 sm:p-10 shadow-sm hover:shadow-md transition">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-600 text-white text-xs font-bold uppercase tracking-wider">
              Vertical 03 • Aviation & Hospitality
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
              Air Hostess & Cabin Crew Training
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
              Turn your dream of flying into reality. Our specialized grooming curriculum covers in-flight safety, customer hospitality, English communication fluency, grooming standards, and airline interview crack techniques.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <div class="flex items-center gap-2 text-sm text-slate-700">
                <svg class="w-4 h-4 text-amber-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
