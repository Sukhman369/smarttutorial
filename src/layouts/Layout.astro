---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Smart Tutorials | IELTS, PTE, Visa Filing, Aviation & Computer AI Institute in Samana",
  description = "Premier training institute in Samana (Patiala) offering IELTS, PTE, Visa Filing (Canada, UK, Australia), Air Hostess & Aviation trainings, and practical Computer & AI courses."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="IELTS Samana, PTE coaching Samana, Visa consultant Samana Patiala, Air hostess training Punjab, Computer institute Samana, AI courses Samana, Study visa Canada Patiala" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Smart Tutorials" />

    <!-- Font preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-50 text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] antialiased flex flex-col min-h-screen selection:bg-blue-600 selection:text-white">
    <slot />
  </body>
</html>
